<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Background Colors -->
  <Color x:Key="Colors.Background.Static">#FF3B82F6</Color>
  <Color x:Key="Colors.Background.MouseOver">#FF60A5FA</Color>
  <Color x:Key="Colors.Background.Pressed">#FF2563EB</Color>
  <Color x:Key="Colors.Background.Checked">#FF4C24EB</Color>
  <Color x:Key="Colors.Background.CheckedMouseOver">#FF6128FF</Color>
  <Color x:Key="Colors.Background.CheckedPressed">#FF4D20CC</Color>
  <Color x:Key="Colors.Background.Disabled">#FF4A5568</Color>

  <!-- Foreground Colors -->
  <Color x:Key="Colors.Foreground.Static">#FFE2E8F0</Color> 
  <Color x:Key="Colors.Foreground.MouseOver">#FFF7FAFC</Color>
  <Color x:Key="Colors.Foreground.Pressed">#FFFFFFFF</Color>
  <Color x:Key="Colors.Foreground.Checked">#FFFFFFFF</Color>
  <Color x:Key="Colors.Foreground.CheckedMouseOver">#FFF7FAFC</Color>
  <Color x:Key="Colors.Foreground.CheckedPressed">#FFFFFFFF</Color>
  <Color x:Key="Colors.Foreground.Disabled">#FF718096</Color>

  <!-- Border Colors -->
  <Color x:Key="Colors.Border.Static">#FF4A5568</Color>
  <Color x:Key="Colors.Border.MouseOver">#FF64748B</Color>
  <Color x:Key="Colors.Border.Pressed">#FF475569</Color>
  <Color x:Key="Colors.Border.Checked">#FF30147F</Color>
  <Color x:Key="Colors.Border.CheckedMouseOver">#FF30147F</Color>
  <Color x:Key="Colors.Border.CheckedPressed">#FF130732</Color>
  <Color x:Key="Colors.Border.Disabled">#FF374151</Color>

  <!-- Panel Colors -->
  <Color x:Key="Colors.PanelBackground.Primary">#FF1A202C</Color>
  <Color x:Key="Colors.PanelBackground.Secondary">#FF2D3748</Color>
  <Color x:Key="Colors.PanelForeground.Primary">#FFE2E8F0</Color>
  <Color x:Key="Colors.PanelForeground.Secondary">#FF94A3B8</Color>

  <!-- Input Backgrounds (e.g. TextBox) -->
  <Color x:Key="Colors.InputBackground.Static">#FF2D3748</Color> 
  <Color x:Key="Colors.InputBackground.MouseOver">#FF374151</Color>
  <Color x:Key="Colors.InputBackground.Pressed">#FF1F2937</Color>
  <Color x:Key="Colors.InputBackground.Checked">#FF374151</Color>
  <Color x:Key="Colors.InputBackground.CheckedMouseOver">#FF3B4A5A</Color>
  <Color x:Key="Colors.InputBackground.CheckedPressed">#FF1F2937</Color>
  <Color x:Key="Colors.InputBackground.Disabled">#FF1F2937</Color>
  
  <!-- Input Foregrounds (e.g. TextBox) -->
  <Color x:Key="Colors.InputForeground.Static">#FFE2E8F0</Color>
  <Color x:Key="Colors.InputForeground.MouseOver">#FFF7FAFC</Color>
  <Color x:Key="Colors.InputForeground.Checked">#FFF7FAFC</Color>
  <Color x:Key="Colors.InputForeground.CheckedMouseOver">#FFFFFFFF</Color>
  <Color x:Key="Colors.InputForeground.Pressed">#FFF7FAFC</Color>
  <Color x:Key="Colors.InputForeground.PressedMouseOver">#FFFFFFFF</Color>
  <Color x:Key="Colors.InputForeground.Disabled">#FF6B7280</Color>

  <!-- State mark colors used by both CheckBox and RadioButton -->
  <Color x:Key="Colors.StateMark.Checked">#FFFBBF24</Color>
  <Color x:Key="Colors.StateMark.CheckedMouseOver">#FFFCD34D</Color>
  <Color x:Key="Colors.StateMark.CheckedPressed">#FFF59E0B</Color>
  <Color x:Key="Colors.StateMark.Disabled">#FF6B7280</Color>

  <!-- ScrollBar Colors -->
  <Color x:Key="Colors.ScrollBar.Track">#FF1F2937</Color>
  <Color x:Key="Colors.ScrollBar.Thumb.Static">#FF4A5568</Color>
  <Color x:Key="Colors.ScrollBar.Thumb.MouseOver">#FF64748B</Color>
  <Color x:Key="Colors.ScrollBar.Thumb.Pressed">#FF374151</Color>
  <Color x:Key="Colors.ScrollBar.Thumb.Disabled">#FF374151</Color>
</ResourceDictionary>