<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Background Colors -->
  <Color x:Key="Colors.Background.Static">#FF1E90FF</Color>
  <Color x:Key="Colors.Background.MouseOver">#FF3FA9FF</Color>
  <Color x:Key="Colors.Background.Pressed">#FF1177D9</Color>
  <Color x:Key="Colors.Background.Checked">#FF3FA9FF</Color>
  <Color x:Key="Colors.Background.CheckedMouseOver">#FF6BABFF</Color>
  <Color x:Key="Colors.Background.CheckedPressed">#FF155B9A</Color>
  <Color x:Key="Colors.Background.Disabled">#FF62757D</Color>

  <!-- Foreground Colors -->
  <Color x:Key="Colors.Foreground.Static">#FFF8FBFD</Color> 
  <Color x:Key="Colors.Foreground.MouseOver">#FFFFFFFF</Color>
  <Color x:Key="Colors.Foreground.Pressed">#FFEFF6FA</Color>
  <Color x:Key="Colors.Foreground.Checked">#FFFFFFFF</Color>
  <Color x:Key="Colors.Foreground.CheckedMouseOver">#FFF2F7FF</Color>
  <Color x:Key="Colors.Foreground.CheckedPressed">#FFEAF4FF</Color>
  <Color x:Key="Colors.Foreground.Disabled">#FF7B8189</Color>

  <!-- Border Colors -->
  <Color x:Key="Colors.Border.Static">#FF36454C</Color>
  <Color x:Key="Colors.Border.MouseOver">#FF41545C</Color>
  <Color x:Key="Colors.Border.Pressed">#FF50636B</Color>
  <Color x:Key="Colors.Border.Checked">#FF1E90FF</Color>
  <Color x:Key="Colors.Border.CheckedMouseOver">#FF1A75CC</Color>
  <Color x:Key="Colors.Border.CheckedPressed">#FF155B9A</Color>
  <Color x:Key="Colors.Border.Disabled">#FF263238</Color>

  <!-- Panel Colors -->
  <Color x:Key="Colors.PanelBackground.Primary">#FF3B636B</Color>
  <Color x:Key="Colors.PanelBackground.Secondary">#FF4B7A82</Color>
  <Color x:Key="Colors.PanelForeground.Primary">#FFF8FBFD</Color>
  <Color x:Key="Colors.PanelForeground.Secondary">#FFA8CBFD</Color>

  <!-- Input Backgrounds (e.g. TextBox) -->
  <Color x:Key="Colors.InputBackground.Static">#FFF2F5F7</Color> 
  <Color x:Key="Colors.InputBackground.MouseOver">#FFF5F8FA</Color>
  <Color x:Key="Colors.InputBackground.Pressed">#FFEFF4F6</Color>
  <Color x:Key="Colors.InputBackground.Checked">#FFEFF6F8</Color>
  <Color x:Key="Colors.InputBackground.CheckedMouseOver">#FFEAF4F6</Color>
  <Color x:Key="Colors.InputBackground.CheckedPressed">#FFE3EBEE</Color>
  <Color x:Key="Colors.InputBackground.Disabled">#FFF0F2F3</Color>
  
  <!-- Input Foregrounds (e.g. TextBox) -->
  <Color x:Key="Colors.InputForeground.Static">#FF102024</Color>
  <Color x:Key="Colors.InputForeground.MouseOver">#FF0E1A20</Color>
  <Color x:Key="Colors.InputForeground.Checked">#FF0E1A20</Color>
  <Color x:Key="Colors.InputForeground.CheckedMouseOver">#FF0E1A20</Color>
  <Color x:Key="Colors.InputForeground.Pressed">#FF0E1A20</Color>
  <Color x:Key="Colors.InputForeground.PressedMouseOver">#FF0E1A20</Color>
  <Color x:Key="Colors.InputForeground.Disabled">#FF9AA0A4</Color>

  <!-- State mark colors used by both CheckBox and RadioButton -->
  <Color x:Key="Colors.StateMark.Checked">#FFFFA000</Color>
  <Color x:Key="Colors.StateMark.CheckedMouseOver">#FFFF8F00</Color>
  <Color x:Key="Colors.StateMark.CheckedPressed">#FFFF6F00</Color>
  <Color x:Key="Colors.StateMark.Disabled">#FF7B8189</Color>

  <!-- ScrollBar Colors -->
  <Color x:Key="Colors.ScrollBar.Track">#FF62757D</Color>
  <Color x:Key="Colors.ScrollBar.Thumb.Static">#FF1E90FF</Color>
  <Color x:Key="Colors.ScrollBar.Thumb.MouseOver">#FF3FA9FF</Color>
  <Color x:Key="Colors.ScrollBar.Thumb.Pressed">#FF1177D9</Color>
  <Color x:Key="Colors.ScrollBar.Thumb.Disabled">#FF62757D</Color>
</ResourceDictionary>