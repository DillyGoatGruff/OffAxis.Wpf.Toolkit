<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:con="clr-namespace:OffAxis.Wpf.Toolkit.UIThemes.Styles.GroupBox.Converters"
                    xmlns:ap="clr-namespace:OffAxis.Wpf.Toolkit.UIThemes.Styles.GroupBox.AttachedProperties">

  <BorderGapMaskConverter x:Key="BorderGapMaskConverter"/>
  <con:MultiplyByParameterConverter x:Key="multiplyByParameterConverter" />
  
  <con:HeaderVerticalOffsetConverter x:Key="headerVerticalOffsetConverter"/>
  <con:HeaderHorizontalOffsetConverter x:Key="headerHorizontalOffsetConverter"/>

  <Thickness x:Key="GroupBox.InnerBorderThickness">1</Thickness>
  <CornerRadius x:Key="GroupBox.CornerRadius">5</CornerRadius>
  <Color x:Key="GroupBox.Colors.InnerBorderBrush">#FFD5DFE5</Color>
  <SolidColorBrush x:Key="GroupBox.Brushes.InnerBorderBrush" Color="{DynamicResource GroupBox.Colors.InnerBorderBrush}"/>

  <Style x:Key="GroupBox.Style" TargetType="{x:Type GroupBox}">
    <Setter Property="BorderBrush" Value="{DynamicResource GroupBox.Brushes.InnerBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.Static}"/>
    <Setter Property="ap:GroupBoxProperties.InnerBorderThickness" Value="{DynamicResource GroupBox.InnerBorderThickness}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type GroupBox}">
          <Grid SnapsToDevicePixels="true">
            <Grid.RowDefinitions>
              <RowDefinition Height="auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="1" Grid.RowSpan="2"
                    CornerRadius="{DynamicResource GroupBox.CornerRadius}"
                    BorderBrush="{DynamicResource Brushes.Border.Static}"
                    BorderThickness="{TemplateBinding BorderThickness}" >
              <Border CornerRadius="{DynamicResource GroupBox.CornerRadius}"
                      BorderBrush="{TemplateBinding BorderBrush}" 
                      BorderThickness="{DynamicResource GroupBox.InnerBorderThickness}">
                <Border CornerRadius="{DynamicResource GroupBox.CornerRadius}"
                        Background="{DynamicResource Brushes.PanelBackground.Primary}"
                        BorderBrush="{DynamicResource Brushes.Border.Static}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                  <ContentPresenter Grid.Row="2" 
                                    Margin="{TemplateBinding Padding}" 
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>

                </Border>
              </Border>
            </Border>
            <Grid Grid.RowSpan="2">
              <Grid.Margin>
                <MultiBinding Converter="{StaticResource headerHorizontalOffsetConverter}">
                  <Binding Path="BorderThickness" RelativeSource="{RelativeSource TemplatedParent}"/>
                  <Binding Path="(ap:GroupBoxProperties.InnerBorderThickness)" RelativeSource="{RelativeSource TemplatedParent}"/>
                </MultiBinding>
              </Grid.Margin>
              <Border x:Name="Header" Grid.RowSpan="3" 
                      VerticalAlignment="Top" HorizontalAlignment="Left" 
                      CornerRadius="{DynamicResource GroupBox.CornerRadius}"
                      Background="{DynamicResource Brushes.PanelBackground.Primary}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      BorderBrush="{DynamicResource Brushes.Border.Static}"
                      MinHeight="{TemplateBinding BorderThickness, 
                        Converter={StaticResource multiplyByParameterConverter},
                        ConverterParameter=3}">
                <Border.Margin>
                  <MultiBinding Converter="{StaticResource headerVerticalOffsetConverter}">
                    <Binding Path="ActualHeight" ElementName="contentPresenterHeader"/>
                    <Binding Path="(ap:GroupBoxProperties.InnerBorderThickness)" RelativeSource="{RelativeSource TemplatedParent}"/>
                  </MultiBinding>
                </Border.Margin>

                <ContentPresenter Grid.RowSpan="2" Margin="5,0" x:Name="contentPresenterHeader"
                                  ContentSource="Header" 
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  RecognizesAccessKey="True" 
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
              </Border>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>