<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="RadioButton.Style" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.Static}"/>
    <Setter Property="Background" Value="{DynamicResource Brushes.Background.Static}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brushes.Border.Static}"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid Background="Transparent"
                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="6"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Outer circle -->
            <Ellipse x:Name="outer"
                     Width="16" Height="16"
                     Fill="{TemplateBinding Background}"
                     Stroke="{TemplateBinding BorderBrush}"
                     StrokeThickness="{TemplateBinding BorderThickness}"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"/>

            <!-- Inner dot -->
            <Ellipse x:Name="dot"
                     Grid.Column="0"
                     Width="8" Height="8"
                     Fill="{DynamicResource Brushes.InputForeground.Static}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Visibility="Collapsed"/>

            <!-- Content -->
            <ContentPresenter Grid.Column="2"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True"
                              ContentSource="Content"
                              Margin="0"/>

          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="outer" Property="Fill" Value="{DynamicResource Brushes.Background.MouseOver}"/>
              <Setter TargetName="outer" Property="Stroke" Value="{DynamicResource Brushes.Border.MouseOver}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.MouseOver}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="outer" Property="Fill" Value="{DynamicResource Brushes.Background.Pressed}"/>
              <Setter TargetName="outer" Property="Stroke" Value="{DynamicResource Brushes.Border.Pressed}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.Pressed}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="outer" Property="Fill" Value="{DynamicResource Brushes.Background.Checked}"/>
              <Setter TargetName="outer" Property="Stroke" Value="{DynamicResource Brushes.Border.Checked}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.Checked}"/>
              <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Brushes.StateMark.Checked}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="outer" Property="Fill" Value="{DynamicResource Brushes.Background.CheckedMouseOver}"/>
              <Setter TargetName="outer" Property="Stroke" Value="{DynamicResource Brushes.Border.CheckedMouseOver}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.CheckedMouseOver}"/>
              <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Brushes.StateMark.CheckedMouseOver}"/>
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True"/>
                <Condition Property="IsPressed" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="outer" Property="Fill" Value="{DynamicResource Brushes.Background.CheckedPressed}"/>
              <Setter TargetName="outer" Property="Stroke" Value="{DynamicResource Brushes.Border.CheckedPressed}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.CheckedPressed}"/>
              <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Brushes.StateMark.CheckedPressed}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="outer" Property="Fill" Value="{DynamicResource Brushes.Background.Disabled}"/>
              <Setter TargetName="outer" Property="Stroke" Value="{DynamicResource Brushes.Border.Disabled}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.Disabled}"/>
              <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              <Setter TargetName="dot" Property="Fill" Value="{DynamicResource Brushes.StateMark.Disabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>