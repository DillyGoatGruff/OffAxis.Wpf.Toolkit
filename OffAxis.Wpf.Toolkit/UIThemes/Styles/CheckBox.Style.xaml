<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Default CornerRadius -->
  <CornerRadius x:Key="CheckBox.CornerRadius.Static">3</CornerRadius>
  <CornerRadius x:Key="CheckBox.CornerRadius.MouseOver">2.5</CornerRadius>
  <CornerRadius x:Key="CheckBox.CornerRadius.Pressed">2.5</CornerRadius>
  <CornerRadius x:Key="CheckBox.CornerRadius.Checked">3</CornerRadius>
  <CornerRadius x:Key="CheckBox.CornerRadius.CheckedMouseOver">3</CornerRadius>
  <CornerRadius x:Key="CheckBox.CornerRadius.CheckedPressed">3</CornerRadius>
  <CornerRadius x:Key="CheckBox.CornerRadius.Disabled">3</CornerRadius>

  <!-- Simple CheckBox style using the project's brush palette -->
  <Style x:Key="CheckBox.Style" TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.Static}"/>
    <Setter Property="Background" Value="{DynamicResource Brushes.Background.Static}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brushes.Border.Static}"/>
    <Setter Property="Border.CornerRadius" Value="{DynamicResource CheckBox.CornerRadius.Static}"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Grid VerticalAlignment="Center" Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="6"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Box -->
            <Border x:Name="box"
                            Width="16" Height="16"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding Border.CornerRadius}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"/>

            <!-- Check mark -->
            <Path x:Name="checkMark"
                          Grid.Column="0"
                          Width="10" Height="10"
                          Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 2 6 L 5 9 L 10 2"
                          StrokeThickness="2"
                          Visibility="Collapsed"/>

            <!-- Content -->
            <ContentPresenter Grid.Column="2"
                              RecognizesAccessKey="True"
                              ContentSource="Content"
                              Margin="0"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="Background" Value="{DynamicResource Brushes.Background.MouseOver}"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Brushes.Border.MouseOver}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.MouseOver}"/>
              <Setter Property="Border.CornerRadius" Value="{DynamicResource CheckBox.CornerRadius.MouseOver}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="box" Property="Background" Value="{DynamicResource Brushes.Background.Pressed}"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Brushes.Border.Pressed}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.Pressed}"/>
              <Setter Property="Border.CornerRadius" Value="{DynamicResource CheckBox.CornerRadius.Pressed}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{DynamicResource Brushes.Background.Checked}"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Brushes.Border.Checked}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.Checked}"/>
              <Setter Property="Border.CornerRadius" Value="{DynamicResource CheckBox.CornerRadius.Checked}"/>
              <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
              <Setter TargetName="checkMark" Property="Stroke" Value="{DynamicResource Brushes.StateMark.Checked}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="box" Property="Background" Value="{DynamicResource Brushes.Background.CheckedMouseOver}"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Brushes.Border.CheckedMouseOver}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.CheckedMouseOver}"/>
              <Setter Property="Border.CornerRadius" Value="{DynamicResource CheckBox.CornerRadius.CheckedMouseOver}"/>
              <Setter TargetName="checkMark" Property="Stroke" Value="{DynamicResource Brushes.StateMark.CheckedMouseOver}"/>
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True"/>
                <Condition Property="IsPressed" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="box" Property="Background" Value="{DynamicResource Brushes.Background.CheckedPressed}"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Brushes.Border.CheckedPressed}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.CheckedPressed}"/>
              <Setter Property="Border.CornerRadius" Value="{DynamicResource CheckBox.CornerRadius.CheckedPressed}"/>
              <Setter TargetName="checkMark" Property="Stroke" Value="{DynamicResource Brushes.StateMark.CheckedPressed}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="box" Property="Background" Value="{DynamicResource Brushes.Background.Disabled}"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Brushes.Border.Disabled}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.Disabled}"/>
              <Setter Property="Border.CornerRadius" Value="{DynamicResource CheckBox.CornerRadius.Disabled}"/>
              <Setter TargetName="checkMark" Property="Stroke" Value="{DynamicResource Brushes.StateMark.Disabled}"/>
            </Trigger>

          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
