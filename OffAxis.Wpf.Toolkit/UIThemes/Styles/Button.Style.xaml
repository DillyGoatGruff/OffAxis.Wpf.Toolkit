<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Default CornerRadius -->
  <CornerRadius x:Key="Button.CornerRadius.Static">5</CornerRadius>
  <CornerRadius x:Key="Button.CornerRadius.MouseOver">5</CornerRadius>
  <CornerRadius x:Key="Button.CornerRadius.Pressed">5</CornerRadius>
  <CornerRadius x:Key="Button.CornerRadius.Disabled">5</CornerRadius>

  <Style x:Key="Button.Style" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{DynamicResource Brushes.Background.Static}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.Static}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brushes.Border.Static}"/>
    <Setter Property="Border.CornerRadius" Value="{DynamicResource Button.CornerRadius.Static}"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="border" 
                  Background="{TemplateBinding Background}" 
                  BorderBrush="{TemplateBinding BorderBrush}" 
                  BorderThickness="{TemplateBinding BorderThickness}" 
                  CornerRadius="{TemplateBinding Border.CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="border" Property="Background" Value="{DynamicResource Brushes.Background.MouseOver}"/>
              <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brushes.Border.MouseOver}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.MouseOver}"/>
              <Setter Property="Border.CornerRadius" Value="{DynamicResource Button.CornerRadius.MouseOver}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="border" Property="Background" Value="{DynamicResource Brushes.Background.Pressed}"/>
              <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brushes.Border.Pressed}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.Pressed}"/>
              <Setter Property="Border.CornerRadius" Value="{DynamicResource Button.CornerRadius.Pressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="border" Property="Background" Value="{DynamicResource Brushes.Background.Disabled}"/>
              <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Brushes.Border.Disabled}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brushes.Foreground.Disabled}"/>
              <Setter Property="Border.CornerRadius" Value="{DynamicResource Button.CornerRadius.Disabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>