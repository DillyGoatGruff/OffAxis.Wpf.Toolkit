<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Default CornerRadius -->
  <CornerRadius x:Key="TextBox.CornerRadius.Static">3</CornerRadius>
  <CornerRadius x:Key="TextBox.CornerRadius.MouseOver">3</CornerRadius>
  <CornerRadius x:Key="TextBox.CornerRadius.Focused">3</CornerRadius>
  <CornerRadius x:Key="TextBox.CornerRadius.Disabled">3</CornerRadius>

  <Style x:Key="TextBox.Style" TargetType="{x:Type TextBox}">
    <Setter Property="Background" Value="{DynamicResource Brushes.InputBackground.Static}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brushes.InputForeground.Static}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brushes.Border.Static}"/>
    <Setter Property="Border.CornerRadius" Value="{DynamicResource TextBox.CornerRadius.Static}"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border x:Name="border" 
                  Background="{TemplateBinding Background}" 
                  BorderBrush="{TemplateBinding BorderBrush}" 
                  BorderThickness="{TemplateBinding BorderThickness}" 
                  CornerRadius="{TemplateBinding Border.CornerRadius}"
                  Padding="{TemplateBinding Padding}">

            <!-- Use PART_ContentHost so the TextBox's text content appears -->
            <ScrollViewer x:Name="PART_ContentHost"
                          SnapsToDevicePixels="True"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="border" Property="Background" Value="{DynamicResource Brushes.InputBackground.MouseOver}"/>
              <Setter Property="Foreground" Value="{DynamicResource Brushes.InputForeground.MouseOver}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource Brushes.Border.MouseOver}"/>
              <Setter Property="Border.CornerRadius" Value="{DynamicResource TextBox.CornerRadius.MouseOver}"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter Property="Border.CornerRadius" Value="{DynamicResource TextBox.CornerRadius.Focused}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
              <Setter Property="Border.CornerRadius" Value="{DynamicResource TextBox.CornerRadius.Disabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>